# ==========================================
# RV VERIFY - Configuration Environment
# ==========================================

# Discord Bot Credentials (from https://discord.com/developers/applications)
DISCORD_BOT_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_client_id_here
DISCORD_CLIENT_SECRET=your_client_secret_here

# Web Server Configuration
PORT=3000
# The public URL where your bot web verification is hosted (e.g. https://verify.yourdomain.com or http://localhost:3000)
BASE_URL=http://localhost:3000

# Security Secrets (Generate random strings for production)
JWT_SECRET=super_secret_jwt_random_string_change_this_rv_verify
COOKIE_SECRET=super_secret_cookie_random_string_change_this_rv_verify

# Anti-Alt & Security Rules
# Minimum account age required to verify (in days, e.g. 3, 7, 14)
MIN_ACCOUNT_AGE_DAYS=3

# Block VPNs / Datacenter Proxies (true/false)
BLOCK_VPN=true

# Strict Alt Blocking: If true, blocks verification and alerts admins. If false, alerts admins only.
STRICT_ALT_BLOCK=true

# Optional: ProxyCheck.io API Key for 100% accurate residential proxy/VPN detection (Free 1,000 queries/day at proxycheck.io)
PROXYCHECK_KEY=
